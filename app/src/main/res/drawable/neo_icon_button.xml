<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="@color/board_shadow" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <corners android:radius="18dp" />
                    <solid android:color="@color/chip_blue_soft" />
                    <stroke android:width="1dp" android:color="@color/accent_secondary" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/bg_elevated"
                        android:endColor="@color/chip_gold_soft" />
                    <stroke android:width="1dp" android:color="@color/board_outline" />
                </shape>
            </item>
        </selector>
    </item>
</layer-list>
