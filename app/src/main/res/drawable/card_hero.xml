<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape>
            <corners android:radius="@dimen/card_corner_radius_lg" />
            <solid android:color="#D9A019" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape>
            <corners android:radius="@dimen/card_corner_radius_lg" />
            <gradient
                android:angle="315"
                android:startColor="#FFF3CB"
                android:endColor="#FFE09A"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#F0C96D" />
        </shape>
    </item>
</layer-list>
