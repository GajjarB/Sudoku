<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_surface_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
            <TextView android:id="@+id/tv_row_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sound" android:textColor="@color/text_primary" android:textStyle="bold" />
            <TextView android:id="@+id/tv_row_subtitle" style="@style/TextAppearance.Neo.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="On" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=">"
        android:textColor="@color/text_muted"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
