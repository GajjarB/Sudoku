<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_home_greeting"
                    style="@style/TextAppearance.Neo.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good morning" />

                <TextView
                    android:id="@+id/tv_home_subtitle"
                    style="@style/TextAppearance.Neo.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/home_greeting_subtitle" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_home_settings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/neo_icon_button"
                android:contentDescription="@string/menu_settings"
                android:padding="14dp"
                android:src="@drawable/ic_settings_24" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_home_streak_chip"
                style="@style/Badge.Streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 0 Day Streak" />

            <TextView
                android:id="@+id/tv_home_xp_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_accent"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="⭐ 0 XP"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_surface_card_highlight"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Neo.Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_daily_title" />

                <TextView
                    android:id="@+id/tv_daily_reward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/achievement_badge"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/home_daily_reward"
                    android:textColor="@color/accent_primary_pressed"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_daily_difficulty"
                style="@style/TextAppearance.Neo.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_daily_meta_default" />

            <TextView
                android:id="@+id/tv_daily_status"
                style="@style/TextAppearance.Neo.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_daily_status_default" />

            <Button
                android:id="@+id/btn_daily_action"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="@string/home_daily_start" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_continue_game"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/TextAppearance.Neo.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_continue_game" />

            <TextView
                android:id="@+id/tv_continue_title"
                style="@style/TextAppearance.Neo.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_continue_title_empty" />

            <TextView
                android:id="@+id/tv_continue_meta"
                style="@style/TextAppearance.Neo.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/home_continue_meta_empty" />

            <Button
                android:id="@+id/btn_continue_action"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="@string/home_continue_action_start" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_unit_title"
            style="@style/TextAppearance.Neo.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/home_path_title" />

        <TextView
            style="@style/TextAppearance.Neo.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home_path_subtitle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_level_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
