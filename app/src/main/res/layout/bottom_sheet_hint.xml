<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_elevated"
    android:orientation="vertical"
    android:padding="@dimen/space_20">

    <TextView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/chip_accent"
        android:gravity="center"
        android:text="💡"
        android:textSize="26sp" />

    <TextView
        style="@style/TextAppearance.Neo.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="Smart hint" />

    <TextView
        android:id="@+id/tv_hint_text"
        style="@style/TextAppearance.Neo.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="Look for a row, column, or box with few candidates left." />

    <Button
        android:id="@+id/btn_hint_more"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/neo_button_height"
        android:layout_marginTop="@dimen/space_16"
        android:text="Show more help" />

    <Button
        android:id="@+id/btn_hint_apply"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/neo_button_height"
        android:layout_marginTop="@dimen/space_8"
        android:text="Got it" />
</LinearLayout>
