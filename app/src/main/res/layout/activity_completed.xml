<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_reward_card_soft"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_trophy"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/achievement_badge"
                android:gravity="center"
                android:text="🏆"
                android:textSize="34sp" />

            <TextView
                style="@style/TextAppearance.Neo.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/completed_title" />

            <TextView
                style="@style/TextAppearance.Neo.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/completed_body" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:columnCount="2">

                <TextView
                    android:id="@+id/tv_completed_time"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_surface_card"
                    android:gravity="center"
                    android:text="00:00\nTime"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_completed_mistakes"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_surface_card"
                    android:gravity="center"
                    android:text="0\nMistakes"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_completed_accuracy"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_surface_card"
                    android:gravity="center"
                    android:text="100%\nAccuracy"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_completed_hints"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_surface_card"
                    android:gravity="center"
                    android:text="0\nHints Used"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_completed_difficulty"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_surface_card"
                    android:gravity="center"
                    android:text="Easy\nDifficulty"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_completed_xp"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_surface_card"
                    android:gravity="center"
                    android:text="+100\nXP"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
            </GridLayout>

            <TextView
                android:id="@+id/tv_completed_streak"
                style="@style/TextAppearance.Neo.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/completed_streak_default" />

            <TextView
                android:id="@+id/tv_completed_goal_progress"
                style="@style/TextAppearance.Neo.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/completed_goal_progress_default" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_continue"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/completed_play_again" />

        <Button
            android:id="@+id/btn_next_puzzle"
            style="@style/Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/completed_next_puzzle" />

        <Button
            android:id="@+id/btn_back_home"
            style="@style/Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/completed_home" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
