<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/window_gradient_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_20">

    <TextView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/chip_accent"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/accent_success"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        style="@style/TextAppearance.Neo.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:text="Great Job!" />

    <TextView
        style="@style/TextAppearance.Neo.Body"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:text="You completed the puzzle." />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:columnCount="2">

        <TextView
            android:id="@+id/tv_completed_time"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_columnWeight="1"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_8"
            android:background="@drawable/stat_tile"
            android:gravity="center"
            android:text="00:00\nTime"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_completed_mistakes"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_columnWeight="1"
            android:layout_marginBottom="@dimen/space_8"
            android:background="@drawable/stat_tile"
            android:gravity="center"
            android:text="0\nMistakes"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_completed_accuracy"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_columnWeight="1"
            android:layout_marginEnd="@dimen/space_8"
            android:background="@drawable/stat_tile"
            android:gravity="center"
            android:text="100%\nAccuracy"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_completed_xp"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_columnWeight="1"
            android:background="@drawable/stat_tile"
            android:gravity="center"
            android:text="+100\nXP"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </GridLayout>

    <Button
        android:id="@+id/btn_next_puzzle"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/neo_button_height"
        android:layout_marginTop="@dimen/space_24"
        android:text="Next Puzzle" />

    <Button
        android:id="@+id/btn_back_home"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/neo_button_height"
        android:layout_marginTop="@dimen/space_8"
        android:text="Back to Home" />

    <Button
        android:id="@+id/btn_share"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/neo_button_height"
        android:layout_marginTop="@dimen/space_8"
        android:text="Share" />
</LinearLayout>
