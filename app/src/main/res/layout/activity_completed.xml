<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/window_gradient_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/reward_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_20">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/chip_accent"
            android:gravity="center"
            android:text="��"
            android:textSize="34sp" />

        <TextView
            style="@style/TextAppearance.Neo.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="Level complete!" />

        <TextView
            style="@style/TextAppearance.Neo.Body"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="Great job! Your streak and XP just got a boost." />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:columnCount="2">

            <TextView
                android:id="@+id/tv_completed_time"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/space_8"
                android:layout_marginBottom="@dimen/space_8"
                android:background="@drawable/stat_tile"
                android:gravity="center"
                android:text="00:00\nTime"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_completed_mistakes"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_columnWeight="1"
                android:layout_marginBottom="@dimen/space_8"
                android:background="@drawable/stat_tile"
                android:gravity="center"
                android:text="0\nMistakes"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_completed_accuracy"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/space_8"
                android:background="@drawable/stat_tile"
                android:gravity="center"
                android:text="100%\nAccuracy"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_completed_xp"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_columnWeight="1"
                android:background="@drawable/stat_tile"
                android:gravity="center"
                android:text="+100\nXP"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/achievement_badge"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_8"
            android:text="🏅 Achievement unlocked"
            android:textColor="@color/accent_primary_pressed"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_next_puzzle"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/neo_button_height"
        android:layout_marginTop="@dimen/space_20"
        android:text="Complete next level" />

    <Button
        android:id="@+id/btn_back_home"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/neo_button_height"
        android:layout_marginTop="@dimen/space_8"
        android:text="Back to home" />

    <Button
        android:id="@+id/btn_share"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/neo_button_height"
        android:layout_marginTop="@dimen/space_8"
        android:text="Claim reward" />
</LinearLayout>
