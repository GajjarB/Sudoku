<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_card"
    android:orientation="horizontal"
    android:padding="16dp">
    <TextView android:id="@+id/tv_theme_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Duolingo Green" android:textColor="@color/text_primary" android:textStyle="bold" />
    <TextView android:id="@+id/tv_theme_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active" android:textColor="@color/accent_primary_pressed" android:textStyle="bold" />
</LinearLayout>
