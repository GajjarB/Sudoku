<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/window_gradient_bg"
    android:padding="@dimen/space_16">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/neo_icon_button"
            android:contentDescription="@string/control_back"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_back_24"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Neo.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_mode_classic" />

            <TextView
                android:id="@+id/tv_difficulty"
                style="@style/TextAppearance.Neo.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/difficulty_easy"
                android:textColor="@color/accent_primary_pressed" />
        </LinearLayout>

        <com.example.sudoku.ui.views.TimerView
            android:id="@+id/timer_view"
            android:layout_width="96dp"
            android:layout_height="44dp"
            android:background="@drawable/chip_accent"
            android:contentDescription="@string/game_timer_content_description"
            android:gravity="center"
            android:text="@string/game_timer_default"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_8"
            android:background="@drawable/neo_icon_button"
            android:contentDescription="@string/game_paused"
            android:padding="@dimen/space_12"
            android:src="@android:drawable/ic_media_pause"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btn_game_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_8"
            android:background="@drawable/neo_icon_button"
            android:contentDescription="@string/menu_settings"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_settings_24"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/progress_strip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/neo_card"
        android:orientation="vertical"
        android:padding="@dimen/space_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_mistakes"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="@dimen/space_8"
                android:layout_weight="1"
                android:background="@drawable/chip_danger"
                android:contentDescription="@string/game_mistakes_status_default"
                android:gravity="center"
                android:text="@string/game_mistakes_status_default"
                android:textColor="@color/accent_danger"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hints"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="@dimen/space_8"
                android:layout_weight="1"
                android:background="@drawable/chip_warning"
                android:contentDescription="@string/game_hints_status_default"
                android:gravity="center"
                android:text="@string/game_hints_status_default"
                android:textColor="@color/accent_warning"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_progress_chip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/chip_accent"
                android:gravity="center"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="@string/game_progress_default"
                android:textColor="@color/accent_primary_pressed"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar_game"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="@dimen/space_8"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/neo_progress" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/grid_shell"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/grid_shell_bg"
        android:padding="6dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toTopOf="@id/controls_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_strip">

        <com.example.sudoku.ui.views.SudokuGridView
            android:id="@+id/sudoku_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/game_board_content_description" />

        <TextView
            android:id="@+id/loading_panel"
            style="@style/TextAppearance.Neo.Body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_grid"
            android:gravity="center"
            android:text="@string/game_loading"
            android:textColor="@color/text_muted"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/controls_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/number_pad"
        app:layout_constraintTop_toBottomOf="@id/grid_shell">

        <Button
            android:id="@+id/btn_undo"
            style="@style/Button.Icon"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:contentDescription="@string/control_undo"
            android:drawableTop="@drawable/ic_undo_24"
            android:drawableTint="@color/accent_secondary"
            android:text="@string/control_undo" />

        <Button
            android:id="@+id/btn_redo"
            style="@style/Button.Icon"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:contentDescription="@string/control_redo"
            android:drawableTop="@drawable/ic_redo_24"
            android:drawableTint="@color/accent_secondary"
            android:text="@string/control_redo" />

        <Button
            android:id="@+id/btn_erase"
            style="@style/Button.Icon"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:contentDescription="@string/control_erase"
            android:drawableTop="@drawable/ic_erase_24"
            android:drawableTint="@color/accent_secondary"
            android:text="@string/control_erase" />

        <Button
            android:id="@+id/btn_notes"
            style="@style/Button.Icon"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:contentDescription="@string/control_pencil"
            android:drawableTop="@drawable/ic_notes_24"
            android:drawableTint="@color/accent_secondary"
            android:text="@string/control_pencil" />

        <Button
            android:id="@+id/btn_hint"
            style="@style/Button.Icon"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:contentDescription="@string/control_hint"
            android:drawableTop="@drawable/ic_hint_24"
            android:drawableTint="@color/accent_secondary"
            android:text="@string/control_hint" />
    </LinearLayout>

    <com.example.sudoku.ui.views.NumberPadView
        android:id="@+id/number_pad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/numpad_container"
        android:padding="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/controls_layout" />

    <TextView
        android:id="@+id/tv_feedback_floating"
        style="@style/TextAppearance.Neo.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:background="@drawable/chip_accent"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_8"
        android:text="@string/game_feedback_nice"
        android:textColor="@color/accent_primary_pressed"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controls_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
