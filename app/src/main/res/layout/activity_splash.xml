<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/window_gradient_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <TextView
        android:id="@+id/iv_logo"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/card_hero"
        android:gravity="center"
        android:text="🧩"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/tv_welcome"
        style="@style/TextAppearance.Neo.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:gravity="center"
        android:text="Ready to train your brain?" />

    <TextView
        style="@style/TextAppearance.Neo.Body"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:text="Play daily, build your streak, and unlock rewards." />

    <Button
        android:id="@+id/btn_continue"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/neo_button_height"
        android:layout_marginTop="96dp"
        android:text="Start lesson" />

    <Button
        android:id="@+id/btn_sign_in"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/neo_button_height"
        android:layout_marginTop="@dimen/space_8"
        android:text="Continue" />
</LinearLayout>
