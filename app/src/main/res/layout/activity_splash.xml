<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <TextView
        android:id="@+id/iv_logo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/neo_card"
        android:gravity="center"
        android:text="S"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_welcome"
        style="@style/TextAppearance.Neo.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:gravity="center"
        android:text="Welcome to Sudoku" />

    <TextView
        style="@style/TextAppearance.Neo.Body"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:text="The classic puzzle game for your mind." />

    <Button
        android:id="@+id/btn_continue"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/neo_button_height"
        android:layout_marginTop="96dp"
        android:text="Continue" />

    <Button
        android:id="@+id/btn_sign_in"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/neo_button_height"
        android:layout_marginTop="@dimen/space_8"
        android:background="@android:color/transparent"
        android:text="Sign in"
        android:textColor="@color/text_primary" />
</LinearLayout>
